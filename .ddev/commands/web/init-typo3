#!/usr/bin/env bash
# shellcheck disable=SC2086
set -e

## Description: Initialize TYPO3 installation
## Usage: init-typo3
## Example: ddev init-typo3

readonly dbHost="db"
readonly dbUser="db"
readonly dbPassword="db"
readonly dbName="db"
readonly dbCredentials="-h${dbHost} -u${dbUser} -p${dbPassword}"
readonly functionalFixturePath="/var/www/html/Tests/Functional/Fixtures"
readonly typo3Binary="/var/www/html/vendor/bin/typo3"

function _progress() {
    printf "%s... " "$1"
}

function _done() {
    printf "\e[32mDone\e[39m\n"
}

# Create empty database
_progress "Creating empty database"
mysql -Nse "SHOW TABLES" $dbCredentials "$dbName" | while read -r table; do
    mysql -e "DROP TABLE ${table}" $dbCredentials "$dbName"
done
_done

# Prepare setup environment
export TYPO3_DB_DRIVER=mysqli
export TYPO3_DB_USERNAME="$dbUser"
export TYPO3_DB_PASSWORD="$dbPassword"
export TYPO3_DB_PORT=3306
export TYPO3_DB_HOST="$dbHost"
export TYPO3_DB_DBNAME="$dbName"
export TYPO3_SERVER_TYPE=apache
export TYPO3_PROJECT_NAME="EXT:category_tree"
export TYPO3_SETUP_ADMIN_USERNAME="${TYPO3_SETUP_ADMIN_USERNAME:-admin}"
export TYPO3_SETUP_ADMIN_PASSWORD="${TYPO3_SETUP_ADMIN_PASSWORD:-Password1!}"
export TYPO3_SETUP_ADMIN_EMAIL="${TYPO3_SETUP_ADMIN_EMAIL:-admin@example.com}"

# Set up environment
_progress "Setting up TYPO3 installation"
    "$typo3Binary" setup --no-interaction --force --quiet --create-site="https://${DDEV_HOSTNAME}/"
_done

# Import functional CSV fixtures as demo content.
# be_users.csv is skipped: it defines a passwordless test user that would collide
# with the admin the setup step just created.
for file in "$functionalFixturePath"/*.csv; do
    [ "$(basename "$file")" = "be_users.csv" ] && continue
    _progress "Importing CSV fixture \"$(basename "$file")\""
    python3 - "$file" <<'PYEOF' | mysql $dbCredentials "$dbName"
import csv, sys

with open(sys.argv[1], newline='') as f:
    rows = list(csv.reader(f))

table   = rows[0][0].strip('"')
columns = rows[1][1:]
data    = [r[1:] for r in rows[2:] if len(r) > 1 and any(v.strip() for v in r[1:])]

if not data:
    sys.exit(0)

col_str = ', '.join('`{}`'.format(c) for c in columns)
for row in data:
    vals = ', '.join(
        "'{}'".format(v.replace("'", "''"))
        for v in row
    )
    print('INSERT INTO `{}` ({}) VALUES ({});'.format(table, col_str, vals))
PYEOF
    _done
done

_progress "Flushing caches"
    "$typo3Binary" cache:flush --quiet
_done

printf "\nBackend: \e[36mhttps://%s/typo3/\e[39m (%s)\n" "$DDEV_HOSTNAME" "$TYPO3_SETUP_ADMIN_USERNAME"
